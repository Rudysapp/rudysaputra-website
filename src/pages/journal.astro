---
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import { getSortedPostsList } from "@utils/post";
import { getPostUrl } from "@utils/url";

const allPosts = await getSortedPostsList();
const posts = allPosts.filter((post) => !post.data.draft);
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const alternatives = posts.filter((post) => post.id !== featured?.id).slice(0, 5);
const topics = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort((a, b) => a.localeCompare(b));
---

<GridLayout title="Journal" description="Thoughts, questions, reflections, and everything in between.">
  <div data-featured-topics={JSON.stringify(featured?.data.tags ?? [])} id="journal-editorial" class="card-base journal-type relative w-full min-w-0 overflow-hidden rounded-(--radius-large) px-5 py-8 md:px-10 md:py-12 lg:px-14 lg:py-14">
    <BackwardButton currentPath={Astro.url.pathname} />

    <header class="mb-14 max-w-3xl">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-(--primary)">Thinking · Learning · Reflection</p>
      <h1 class="mb-5 text-4xl font-bold tracking-tight text-90 md:text-6xl">Journal<span class="text-(--primary)">.</span></h1>
      <p class="mb-3 text-lg leading-relaxed text-75">Thoughts, questions, reflections, and everything in between.</p>
      <p class="max-w-xl leading-relaxed text-50">Tidak semua pemikiran bermula dari jawaban. Sebagian justru tumbuh dari pertanyaan yang belum selesai.</p>
    </header>

    {featured && (
      <section class="mb-12" aria-labelledby="journal-featured-title">
        <div class="mb-4 flex items-center gap-3">
          <span class="text-xs font-semibold uppercase tracking-[0.16em] text-(--primary)">01 / A thought worth exploring</span>
          <span class="h-px flex-1 bg-(--line-divider)"></span>
        </div>
        <a href={getPostUrl(featured)} class="group relative block overflow-hidden rounded-2xl border border-(--line-divider) bg-(--card-bg) px-6 py-9 transition-colors hover:border-(--primary) md:px-12 md:py-14">
          <span aria-hidden="true" class="pointer-events-none absolute -right-6 -top-12 select-none text-[9rem] font-black leading-none text-(--primary) opacity-[0.06]">“</span>
          <span class="relative mb-5 block text-xs font-semibold uppercase tracking-[0.18em] text-(--primary)">Selected Thought</span>
          <h2 id="journal-featured-title" class="relative mb-6 max-w-4xl text-3xl font-bold leading-tight tracking-tight text-90 transition-colors group-hover:text-(--primary) md:text-5xl">{featured.data.title}</h2>
          {featured.data.description && <p class="relative mb-8 max-w-2xl text-lg leading-relaxed text-75">{featured.data.description}</p>}
          <span class="relative inline-flex items-center gap-2 text-sm font-semibold text-(--primary)">Explore this thought <span aria-hidden="true">↗</span></span>
        </a>
      </section>
    )}

    <section class="mb-11" aria-labelledby="journal-discovery-title">
      <div class="mb-5 flex items-center gap-3">
        <span class="text-xs font-semibold uppercase tracking-[0.16em] text-(--primary)">02 / Other perspectives</span>
        <span class="h-px flex-1 bg-(--line-divider)"></span>
      </div>
      <h2 id="journal-discovery-title" class="mb-2 text-2xl font-bold text-90">There's more to discover.</h2>
      <p class="mb-6 max-w-2xl text-sm leading-relaxed text-50">Setiap tulisan menawarkan pintu masuk yang berbeda. Temukan gagasan yang paling dekat dengan rasa ingin tahumu hari ini.</p>

      <div id="journal-cards" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite">
        {alternatives.map((post) => (
          <a href={getPostUrl(post)} data-journal-post data-topics={JSON.stringify(post.data.tags ?? [])} class="group flex min-h-56 flex-col justify-between rounded-xl border border-(--line-divider) p-5 transition-colors hover:border-(--primary) hover:bg-(--card-bg)">
            <div>
              <p class="mb-4 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-(--primary)">Thought / Essay</p>
              <h3 class="mb-3 text-lg font-bold leading-snug text-90 transition-colors group-hover:text-(--primary)">{post.data.title}</h3>
              {post.data.description && <p class="line-clamp-3 text-sm leading-relaxed text-50">{post.data.description}</p>}
            </div>
            <span class="mt-5 text-sm font-semibold text-(--primary)">Read this thought ↗</span>
          </a>
        ))}
        <a href="/archive/" class="group flex min-h-56 flex-col justify-between rounded-xl border border-(--primary) bg-(--card-bg) p-5 transition-colors hover:border-(--primary)" aria-label="Tulisan lainnya, buka daftar lengkap tulisan">
          <div>
            <div class="mb-4 flex items-center justify-between gap-3">
              <span class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-(--primary)">Continue exploring</span>
              <span class="text-2xl text-(--primary) transition-transform group-hover:translate-x-1" aria-hidden="true">↗</span>
            </div>
            <h3 class="mb-3 text-xl font-bold text-90">Tulisan Lainnya</h3>
            <p class="text-sm leading-relaxed text-50">Jelajahi kumpulan tulisan, pertanyaan, dan refleksi yang tersedia.</p>
          </div>
          <span class="mt-5 text-sm font-semibold text-(--primary)">Browse all writings →</span>
        </a>
      </div>
      <p id="journal-empty" class="mt-4 hidden text-sm text-50">Belum ada tulisan alternatif yang sesuai dengan topik pilihan. Kamu tetap dapat membuka tulisan utama atau menjelajahi daftar lengkap.</p>
    </section>

    <section class="journal-discovery-cta relative overflow-hidden rounded-2xl border border-(--line-divider) bg-(--card-bg) px-5 py-10 text-center md:px-12 md:py-14" aria-labelledby="journal-topics-title">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-(--primary)">03 / Follow your curiosity</p>
      <h2 id="journal-topics-title" class="mb-4 text-3xl font-semibold tracking-tight text-90 md:text-4xl">What sparks your curiosity?</h2>
      <p class="mx-auto mb-7 max-w-xl text-base leading-relaxed text-75">Setiap gagasan memiliki pintu masuknya sendiri. Pilih topik yang paling dekat dengan rasa ingin tahumu.</p>
      <div id="journal-filters" class="mx-auto mb-5 flex max-w-2xl flex-wrap justify-center gap-3" aria-label="Filter topik">
        {topics.map((topic) => (
          <button type="button" data-topic={topic} aria-pressed="false" class="rounded-full border border-(--line-divider) px-5 py-2.5 text-sm font-medium text-75 transition-colors hover:border-(--primary) hover:text-(--primary)">{topic}</button>
        ))}
      </div>
      {topics.length === 0 && <p class="text-sm text-50">Topik akan tersedia seiring bertambahnya tulisan.</p>}
      <p class="mb-5 text-xs text-50">Kamu dapat memilih lebih dari satu topik.</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <button type="button" id="journal-explore" class="rounded-xl bg-(--primary) px-7 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-85">Explore selected ideas ↗</button>
        <button type="button" id="journal-reset" class="text-sm font-semibold text-(--primary) hover:underline" hidden>Clear filters</button>
      </div>
      <p id="journal-count" class="mt-5 text-sm text-75" aria-live="polite"></p>
      <p id="journal-featured-match" class="mt-2 hidden text-sm text-75">Tulisan utama juga sesuai: <a href={featured ? getPostUrl(featured) : '#'} class="font-semibold text-(--primary) hover:underline">{featured?.data.title}</a></p>
    </section>
  </div>
</GridLayout>


<style is:global>
  /* Journal-only layout. Swup containers remain in the DOM and are still replaced normally.
     :has() derives page state from the current Swup content, so it also works on Back/Forward. */
  body:has(#journal-editorial) #main-grid {
    grid-template-columns: minmax(0, 1fr) !important;
  }
  body:has(#journal-editorial) #main-grid > :not(#swup-container):not(#banner-credit) {
    display: none !important;
  }
  body:has(#journal-editorial) #main-grid > #swup-container {
    grid-column: 1 / -1 !important;
    grid-row: auto !important;
    width: 100%;
    min-width: 0;
    max-width: none;
    margin: 0;
  }
</style>

<style>
  .journal-type {
    font-family: "Geist", "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    font-feature-settings: "ss01" on;
  }
  .journal-type h1, .journal-type h2, .journal-type h3 {
    letter-spacing: -0.035em;
  }
  .journal-discovery-cta {
    background-image: radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--primary) 9%, transparent), transparent 70%);
  }
  #journal-filters button[aria-pressed="true"] {
    border-color: var(--primary);
    background-color: color-mix(in srgb, var(--primary) 18%, transparent);
    color: var(--primary);
    font-weight: 700;
  }
</style>
