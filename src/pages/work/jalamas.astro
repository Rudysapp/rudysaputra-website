---
import GridLayout from '@layouts/grid.astro';
import WorkDetail from '@components/work/WorkDetail.astro';
const sections = [
  { eyebrow: 'The Context', title: 'Sebuah usaha yang tumbuh dari kebutuhan industri.', paragraphs: [
    'PT Jalamas Artha Sakti merupakan perusahaan Indonesia yang berdiri pada 2019 dan bergerak dalam penyediaan kebutuhan industri serta pendukung operasional pertambangan. Bidang ini mempertemukan ketersediaan peralatan, persyaratan teknis, dan keputusan pengadaan.',
    'Keterlibatan saya di dalamnya mengajarkan bahwa memahami produk dan pelanggan saja tidak cukup. Ada sistem kerja dan hubungan/Users/rudysapp/Downloads/rudysaputra-website-main/src/pages/work/jalamas.astro antarpihak yang turut menentukan jalannya operasional sehari-hari.'
  ] },
  { eyebrow: 'The Work', title: 'Dari produk menuju keputusan yang nyata.', paragraphs: [
    'Pekerjaan ini mencakup upaya memahami kebutuhan pasokan industri, berkomunikasi dengan pelanggan dan pemasok, serta menilai bagaimana sebuah usaha dapat memberikan nilai lebih dari sekadar menjual kembali komponen.',
    'Di dalamnya terdapat keputusan mengenai posisi usaha, operasional, dan arah pengembangan ketika keadaan terus berubah.'
  ] },
  { eyebrow: 'Challenges & Decisions', title: 'Ketika pola yang selama ini dikenal mulai dipertanyakan.', paragraphs: [
    'Perubahan hubungan dengan pemasok dan dinamika pasar dapat mengguncang pola usaha yang sebelumnya dianggap berjalan baik. Keadaan tersebut mendorong evaluasi yang lebih jernih tentang di mana perusahaan benar-benar menghadirkan nilai.',
    'Saya tidak memandangnya sebagai kisah keberhasilan yang telah selesai. Ini masih merupakan proses menguji asumsi, menyesuaikan keputusan, dan menghadapi tantangan yang muncul sepanjang perjalanan operasional.'
  ] },
  { eyebrow: 'The Learning', title: 'Memahami nilai yang melampaui transaksi.', paragraphs: [
    'Salah satu pelajaran yang terus saya temukan adalah bahwa model bisnis tidak dapat dipisahkan dari lingkungan tempatnya bekerja. Memahami pelanggan, rantai pasok, dan perubahan kepentingan sama pentingnya dengan memahami produk itu sendiri.',
    'Pengalaman ini terus membentuk cara saya memahami daya tahan, ketepatan mengambil keputusan, dan makna membangun sesuatu yang benar-benar bermanfaat.'
  ] },
];
---
<GridLayout title="Jalamas — Work & Learning" description="Refleksi pribadi tentang pasokan industri, adaptasi usaha, dan pekerjaan di balik Jalamas.">
  <WorkDetail title="Jalamas Artha Sakti, PT" category="Business · Industrial Operations" introduction="Membangun dan menjalankan usaha pemasok kebutuhan industri untuk operasional pertambangan, sambil terus belajar menyesuaikan diri dengan perubahan kebutuhan dan kenyataan pasar." image="/assets/images/featured-work/jalamas.webp" sections={sections} />
</GridLayout>
