---
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";

import { siteConfig } from "@/config";
import { pathsEqual, url } from "@utils/url";
import { widgetManager } from "@utils/widget";
import Navbar from "@components/navbar.astro";
import FullscreenWallpaper from "@components/fullscreenWallpaper.astro";
import Banner from "@components/banner.astro";
import Sidebar from "@components/sidebar.astro";
import Footer from "@components/footer.astro";
import TocButton from "@components/tocButton.astro";
import BackToTopButton from "@components/back2TopButton.astro";
import BaseLayout from "./base.astro";
import "@styles/grid.css";
import HomepageSections from '@/components/homepageSections.astro'

/**
 * Wallpaper
 */

interface Props {
    title?: string;
    banner?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    postSlug?: string;
    headings?: MarkdownHeading[];
}

const {
    title,
    banner,
    description,
    lang,
    setOGTypeArticle,
    postSlug,
    headings = [],
} = Astro.props;
const hasBannerCredit = siteConfig.wallpaper.mode === "banner" && siteConfig.wallpaper.banner?.credit?.enable;
const hasBannerLink = !!siteConfig.wallpaper.banner?.credit?.url;

// 检查是否为首页
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// 检查是否应该启用半透明效果
const shouldEnableTransparency = siteConfig.wallpaper.mode === "banner" || siteConfig.wallpaper.mode === "fullscreen";

// 为组件添加半透明效果的CSS类
const transparentClass = shouldEnableTransparency ? "wallpaper-transparent" : "";

/**
 * Sidebar
 */

// 检查侧边栏是否启用，动态调整网格布局
const {
    hasLeftSidebar,
    hasRightSidebar,
    hasAnyComponents,
    gridCols,
    leftSidebarClass,
    rightSidebarClass,
    mainContentClass,
    middleSidebarClass,
    mobileFooterClass,
} = widgetManager.getGridLayout(headings, Astro.url.pathname);
---

<BaseLayout
    title={title}
    banner={banner}
    description={description}
    lang={lang}
    setOGTypeArticle={setOGTypeArticle}
    postSlug={postSlug}
>
    <!-- Navbar -->
    <slot slot="head" name="head" />
    <div
        id="top-row"
        class="z-50 pointer-events-none relative transition-all duration-600 max-w-(--page-width) px-0 md:px-4 mx-auto h-(--top-row-height)"
    >
        <div
            id="navbar-wrapper"
            class="pointer-events-auto sticky top-0 transition-all"
        >
            <Navbar />
        </div>
    </div>

    <!-- 全屏壁纸 - 总是渲染但通过CSS控制可见性 -->
    <FullscreenWallpaper
        config={siteConfig.wallpaper}
        class={siteConfig.wallpaper.mode === "fullscreen" ? "" : "hidden"}
    />

    <!-- 为全屏壁纸模式添加body类 -->
    {
        shouldEnableTransparency && (
            <script>
                document.body.classList.add('wallpaper-transparent');
            </script>
        )
    }

    <!-- Banner - always keep the Swup container present -->
<div id="swup-banner">
    {!isHomePage && (
        <Banner
            config={siteConfig.wallpaper}
            isHomePage={false}
            class={siteConfig.wallpaper.mode === "banner" ? "" : "hidden"}
        />
    )}
</div>

    <!-- Main content Twilight-->
    <div
    id="main-layout-wrapper"
    class={`absolute w-full z-30 pointer-events-none transition-transform duration-600 top-0 min-h-[calc(100vh-var(--main-content-top))] ${siteConfig.wallpaper.mode !== "banner" ? "no-banner-layout" : ""} ${transparentClass}`}
>
        <div
            class="relative max-w-(--page-width) mx-auto pointer-events-auto"
        >
            <div
                id="main-grid"
                class={`w-full left-0 right-0 grid ${gridCols} grid-rows-[auto] mx-auto gap-4 px-0 md:px-4 ${!hasAnyComponents ? "mobile-no-sidebar" : ""} ${(hasLeftSidebar || hasRightSidebar) ? "mobile-both-sidebar" : ""}`}
            >
                <!-- Banner image credit -->
                {
                    hasBannerCredit && (
                        <a
                            href={siteConfig.wallpaper.banner?.credit?.url}
                            id="banner-credit"
                            target="_blank"
                            rel="noopener"
                            aria-label="Visit image source"
                            class:list={[
                                "group onload-animation-up transition-all absolute flex justify-center items-center rounded-full " +
                                    "px-3 right-4 -top-13 bg-black/60 hover:bg-black/70 h-9",
                                {
                                    "hover:pr-9 active:bg-black/80":
                                        hasBannerLink,
                                },
                            ]}
                        >
                            <Icon
                                class="text-white/75 text-[1.25rem] mr-1"
                                name="material-symbols:copyright-outline-rounded"
                            />
                            <div class="text-white/75 text-xs">
                                {siteConfig.wallpaper.banner?.credit?.text}
                            </div>
                            <Icon
                                class:list={[
                                    "transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                                    {
                                        "group-hover:opacity-100":
                                            hasBannerLink,
                                    },
                                ]}
                                name="fa6-solid:arrow-up-right-from-square"
                            />
                        </a>
                    )
                }
            {isHomePage ? (
    <>
        <div id="left-sidebar" class="hidden"></div>
        <div id="right-sidebar" class="hidden"></div>
    </>
) : (
    <div class="contents lg:contents md:flex md:flex-col md:col-start-1 md:row-start-1 md:gap-4">
        {
            hasLeftSidebar ? (
                <Sidebar
                    id="left-sidebar"
                    side="left"
                    class={`${leftSidebarClass} ${transparentClass} onload-animation-up`}
                    headings={headings}
                />
            ) : (
                <div id="left-sidebar" class="hidden"></div>
            )
        }
        {
            hasRightSidebar ? (
                <Sidebar
                    id="right-sidebar"
                    side="right"
                    class={`${rightSidebarClass} ${transparentClass} onload-animation-up`}
                    headings={headings}
                />
            ) : (
                <div id="right-sidebar" class="hidden"></div>
            )
        }
    </div>
)}

                <main
    id="swup-container"
    class={`${isHomePage ? "col-span-full w-full pointer-events-auto" : mainContentClass} transition-swup-fade`}
  >
    {isHomePage ? (
    <>
        <HomepageSections />

        <div class="footer col-span-full w-full mt-8">
            <Footer />
        </div>
    </>
    ) : (
        <>
            <div
                id="grid-class-carrier"
                data-grid-class={gridCols}
                class="hidden"
            ></div>

            <div
                id="content-wrapper"
                class="onload-animation-up transition-leaving"
            >
                <slot />

                <div
                    class="footer col-span-2 onload-animation-up hidden lg:block transition-swup-fade"
                >
                    <Footer />
                </div>
            </div>
        </>
    )}
</main>

            {isHomePage ? (
    <div id="middle-sidebar" class="hidden"></div>
) : (
    <>
        <div class={middleSidebarClass}>
            <Sidebar
                id="middle-sidebar"
                side="middle"
                class={`${transparentClass} onload-animation-up`}
                headings={headings}
            />
        </div>

        <div class={mobileFooterClass}>
            <Footer />
        </div>
    </>)}
    </div>
</div>
</div>

    <TocButton />

    <BackToTopButton />


<!-- Persistent delegated Journal controls: remains active across Swup page replacements. -->
<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const editorial = document.getElementById("journal-editorial");
    if (!editorial) return;

    const topicButton = target.closest<HTMLButtonElement>("#journal-filters button[data-topic]");
    const resetButton = target.closest<HTMLButtonElement>("#journal-reset");
    const exploreButton = target.closest<HTMLButtonElement>("#journal-explore");
    if (!topicButton && !resetButton && !exploreButton) return;

    const buttons = Array.from(editorial.querySelectorAll<HTMLButtonElement>("#journal-filters button[data-topic]"));
    const cards = Array.from(editorial.querySelectorAll<HTMLElement>("#journal-cards [data-journal-post]"));
    const featuredTopics: string[] = JSON.parse(editorial.dataset.featuredTopics ?? "[]");
    const reset = editorial.querySelector<HTMLButtonElement>("#journal-reset");
    const count = editorial.querySelector<HTMLElement>("#journal-count");
    const empty = editorial.querySelector<HTMLElement>("#journal-empty");
    const featuredMatch = editorial.querySelector<HTMLElement>("#journal-featured-match");

    if (topicButton) {
      const wasPressed = topicButton.getAttribute("aria-pressed") === "true";
      topicButton.setAttribute("aria-pressed", String(!wasPressed));
    }
    if (resetButton) {
      buttons.forEach((button) => button.setAttribute("aria-pressed", "false"));
    }

    const selected = new Set(buttons
      .filter((button) => button.getAttribute("aria-pressed") === "true")
      .map((button) => button.dataset.topic)
      .filter((topic): topic is string => Boolean(topic)));

    let visible = 0;
    for (const card of cards) {
      const tags: string[] = JSON.parse(card.dataset.topics ?? "[]");
      const matches = selected.size === 0 || tags.some((tag) => selected.has(tag));
      card.classList.toggle("hidden", !matches);
      if (matches) visible++;
    }
    const featuredMatches = selected.size === 0 || featuredTopics.some((tag) => selected.has(tag));
    if (count) count.textContent = selected.size > 0 ? `${visible + (featuredMatches ? 1 : 0)} tulisan sesuai pilihan` : "";
    if (featuredMatch) featuredMatch.classList.toggle("hidden", selected.size === 0 || !featuredMatches);
    if (empty) empty.classList.toggle("hidden", selected.size === 0 || visible > 0 || featuredMatches);
    if (reset) reset.hidden = selected.size === 0;

    if (exploreButton) {
      const destination = visible > 0
        ? document.getElementById("journal-discovery-title")
        : featuredMatches
          ? document.getElementById("journal-featured-title")
          : document.getElementById("journal-empty");
      destination?.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  });
</script>

</BaseLayout>

<style is:global>
    #main-layout-wrapper {
        transform: translateY(var(--main-content-top));
    }

    body.is-home #main-layout-wrapper {
        transform: translateY(var(--navbar-height));
    }
</style>