---
interface Section { eyebrow: string; title: string; paragraphs: string[] }
interface Props { title: string; category: string; introduction: string; image: string; sections: Section[]; }
const { title, category, introduction, image, sections } = Astro.props;
---
<article class="work-detail bg-[#f6f4ee] text-[#1c1b18] dark:bg-[#171715] dark:text-[#eceaee] rounded-[var(--radius-large)] overflow-hidden">
  <div class="mx-auto max-w-[1100px] px-5 md:px-12 pt-8 pb-12 md:pt-10 md:pb-20">
    <a href="/#featured-work" class="text-sm underline underline-offset-4 opacity-75 hover:opacity-100">← Back to Featured Works</a>
    <div class="mt-8 border-t border-current/15 pt-4 flex justify-between text-[0.7rem] uppercase tracking-[0.12em] opacity-60"><span>RDS / WORK</span><span>{category}</span></div>
    <h1 class="work-detail-title mt-7 mb-6 font-semibold">
       {title}
    </h1>
    <p class="max-w-[750px] text-[clamp(1.1rem,2vw,1.55rem)] leading-[1.6] opacity-80">{introduction}</p>
    <div class="mt-14 aspect-[16/10] overflow-hidden bg-[#ddd8ce] dark:bg-[#292824]"><img src={image} alt={`Editorial illustration for ${title}; not project documentation`} width="1200" height="750" class="w-full h-full object-cover" /></div>
    <div class="mt-20 md:mt-28">
      {sections.map((section, index) => (
        <section class="grid md:grid-cols-[0.38fr_1fr] gap-6 md:gap-14 border-t border-current/15 py-12 md:py-16">
          <p class="m-0 text-xs tracking-[0.12em] uppercase opacity-60">{String(index + 1).padStart(2, '0')} / {section.eyebrow}</p>
          <div><h2 id={`work-section-${index + 1}`} class="m-0 mb-7 text-[clamp(2rem,4vw,3.5rem)] leading-tight tracking-[-0.04em] font-semibold">{section.title}</h2>{section.paragraphs.map((paragraph) => <p class="max-w-[680px] text-base leading-[1.85] opacity-80">{paragraph}</p>)}</div>
        </section>
      ))}
    </div>
    <div class="border-t border-current/15 pt-10 mt-10"><a href="/#featured-work" class="text-lg underline underline-offset-4">← Explore other works</a></div>
  </div>
</article>

<style>
  .work-detail-title {
    font-size: clamp(2.5rem, 4.3vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    overflow-wrap: normal;
  }
</style>