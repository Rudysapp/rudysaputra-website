---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { url } from "@utils/url";

// 1. Ambil seluruh postingan dari folder content/posts
const allPosts = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

// 2. Filter atau ambil 3 esai unggulan (bisa ditandai 'featured: true' di frontmatter, atau 3 artikel terbaru)
const featuredEssays = allPosts
  .filter((post) => post.data.featured === true || post.data.tags?.includes("featured"))
  .slice(0, 3);

// Jika tidak ada artikel yang di-tag 'featured', ambil 3 artikel terbaru secara otomatis
const displayEssays = featuredEssays.length > 0 ? featuredEssays : allPosts.slice(0, 3);
---

<div class="custom-homepage-wrapper my-12 space-y-12 max-w-6xl mx-auto">

  <!-- 1. HERO SHOWCASE: MANIFESTO & IDENTITY -->
  <section class="relative group overflow-hidden rounded-3xl border border-white/15 bg-neutral-900 shadow-2xl transition-all duration-500 hover:border-blue-500/50">
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img 
        src="https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=1600&auto=format&fit=crop" 
        alt="Sovereign Background" 
        class="w-full h-full object-cover object-center opacity-30 group-hover:scale-105 transition-transform duration-700 ease-out"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/80 to-transparent"></div>
    </div>

    <div class="relative z-10 p-8 md:p-12 space-y-6">
      <div class="inline-flex items-center gap-2.5 rounded-full border border-blue-400/30 bg-blue-500/20 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-blue-300 backdrop-blur-md">
        <Icon name="material-symbols:terminal-rounded" class="text-base" />
        <span>Sovereign Manifesto</span>
      </div>

      <h1 class="text-2xl md:text-4xl font-bold tracking-tight text-white leading-relaxed md:leading-snug">
        "Berpikir dari <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-400">First Principles</span>, membangun kedaulatan mental, dan mengoptimalkan efisiensi intelektual. Teknologi digunakan sebagai pengganda kekuatan, bukan pengganti otak."
      </h1>

      <div class="pt-6 border-t border-white/15 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm text-neutral-200 font-medium">
        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-xl backdrop-blur-sm border border-white/5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-500/20 text-blue-400 font-mono font-bold">01</span>
          <span>First Principles</span>
        </div>
        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-xl backdrop-blur-sm border border-white/5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-500/20 text-indigo-400 font-mono font-bold">02</span>
          <span>Logika Mandiri</span>
        </div>
        <div class="flex items-center gap-3 bg-white/5 p-3 rounded-xl backdrop-blur-sm border border-white/5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-purple-500/20 text-purple-400 font-mono font-bold">03</span>
          <span>Kedaulatan Sistem</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PILAR UTAMA -->
  <div class="space-y-4">
    <h2 class="text-xs font-bold uppercase tracking-widest text-neutral-400 px-2 flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-blue-500"></span> PILAR STRATEGIS
    </h2>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-neutral-900/90 transition-all duration-300 hover:-translate-y-2 hover:border-blue-500/40">
        <div class="h-40 overflow-hidden relative">
          <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=800&auto=format&fit=crop" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Logika" />
          <div class="absolute inset-0 bg-gradient-to-t from-neutral-900 via-neutral-900/40 to-transparent"></div>
          <div class="absolute bottom-3 left-4 p-2 rounded-lg bg-blue-500/20 backdrop-blur-md text-blue-400 border border-blue-500/30">
            <Icon name="material-symbols:psychology-outline-rounded" class="text-2xl" />
          </div>
        </div>
        <div class="p-6 space-y-2">
          <h3 class="text-xl font-bold text-white">Logika & Strategi</h3>
          <p class="text-sm text-neutral-300 leading-relaxed">
            Pemikiran kritis, model mental, dan resolusi masalah rasional yang berakar pada pemahaman mendalam.
          </p>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-neutral-900/90 transition-all duration-300 hover:-translate-y-2 hover:border-emerald-500/40">
        <div class="h-40 overflow-hidden relative">
          <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?q=80&w=800&auto=format&fit=crop" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Infrastruktur" />
          <div class="absolute inset-0 bg-gradient-to-t from-neutral-900 via-neutral-900/40 to-transparent"></div>
          <div class="absolute bottom-3 left-4 p-2 rounded-lg bg-emerald-500/20 backdrop-blur-md text-emerald-400 border border-emerald-500/30">
            <Icon name="material-symbols:account-tree-outline-rounded" class="text-2xl" />
          </div>
        </div>
        <div class="p-6 space-y-2">
          <h3 class="text-xl font-bold text-white">Web & Infrastruktur</h3>
          <p class="text-sm text-neutral-300 leading-relaxed">
            Pembangunan ekosistem digital mandiri, arsitektur data terstruktur, dan performa teknis presisi.
          </p>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-neutral-900/90 transition-all duration-300 hover:-translate-y-2 hover:border-amber-500/40">
        <div class="h-40 overflow-hidden relative">
          <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?q=80&w=800&auto=format&fit=crop" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Kedaulatan" />
          <div class="absolute inset-0 bg-gradient-to-t from-neutral-900 via-neutral-900/40 to-transparent"></div>
          <div class="absolute bottom-3 left-4 p-2 rounded-lg bg-amber-500/20 backdrop-blur-md text-amber-400 border border-amber-500/30">
            <Icon name="material-symbols:shield-outline-rounded" class="text-2xl" />
          </div>
        </div>
        <div class="p-6 space-y-2">
          <h3 class="text-xl font-bold text-white">Otonomi & Kedaulatan</h3>
          <p class="text-sm text-neutral-300 leading-relaxed">
            Kemandirian penuh atas takdir & karya, ketahanan mental tinggi, serta bebas dari narasi victimhood.
          </p>
        </div>
      </div>
    </section>
  </div>

  <!-- 3. ESAI UNGGULAN DINAMIS (MENGARAH KE HALAMAN BACA) -->
  <section class="space-y-4">
    <div class="flex items-center justify-between px-2">
      <h2 class="text-xs font-bold uppercase tracking-widest text-purple-400 flex items-center gap-2">
        <Icon name="material-symbols:auto-stories-outline-rounded" class="text-lg" />
        Esai & Pemikiran Unggulan
      </h2>
      <a href={url('/archive/')} class="text-xs font-semibold text-purple-300 hover:text-purple-200 transition-colors flex items-center gap-1">
        Lihat Semua Tulisan <Icon name="material-symbols:arrow-forward-rounded" />
      </a>
    </div>

    <!-- Grid Kartu Artikel Dinamis -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {displayEssays.map((post) => (
        <a 
          href={url(`/posts/${post.id}/`)} 
          class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-neutral-900/80 p-6 transition-all duration-300 hover:-translate-y-1.5 hover:border-purple-500/50 hover:bg-neutral-900 shadow-lg hover:shadow-purple-500/10"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between text-[11px] font-mono text-neutral-400">
              <span>{post.data.published?.toISOString().split('T')[0] || "Draft"}</span>
              <span class="text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded border border-purple-500/20">
                {post.data.category || "Essay"}
              </span>
            </div>

            <h3 class="text-lg font-bold text-white group-hover:text-purple-300 transition-colors leading-snug">
              {post.data.title}
            </h3>

            <p class="text-xs text-neutral-300 line-clamp-3 leading-relaxed">
              {post.data.description || "Klik untuk membaca selengkapnya esai dan pemikiran ini."}
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-white/10 flex items-center justify-between text-xs font-semibold text-purple-400 group-hover:text-purple-300">
            <span>Baca Selengkapnya</span>
            <Icon name="material-symbols:arrow-forward-rounded" class="text-base group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 4. FEATURED SHOWCASE & KOLABORASI -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 relative overflow-hidden rounded-2xl border border-white/10 bg-neutral-900/80 p-8 flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 flex items-center gap-2">
            <Icon name="material-symbols:code-rounded" class="text-lg" />
            Studi Kasus & Architecture Audit
          </span>
          <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">
            Project Showcase
          </span>
        </div>

        <h3 class="text-2xl font-bold text-white leading-snug">
          Arsitektur Ekosistem Web Mandiri & Infrastruktur Digital
        </h3>

        <p class="text-sm text-neutral-300 leading-relaxed">
          Mengurai penyederhanaan deployment, otomatisasi workflows, dan konfigurasi infrastruktur DNS berbasis Cloudflare & Netlify untuk efisiensi sistem maksimal serta keterandalan jangka panjang.
        </p>
      </div>

      <div class="pt-4 border-t border-white/10 flex flex-wrap gap-2">
        <span class="text-xs font-mono text-neutral-300 bg-white/5 border border-white/10 px-3 py-1 rounded-lg">#Astro Framework</span>
        <span class="text-xs font-mono text-neutral-300 bg-white/5 border border-white/10 px-3 py-1 rounded-lg">#Cloudflare Architecture</span>
        <span class="text-xs font-mono text-neutral-300 bg-white/5 border border-white/10 px-3 py-1 rounded-lg">#Netlify CDN</span>
      </div>
    </div>

    <div class="relative overflow-hidden rounded-2xl border border-amber-500/30 bg-gradient-to-br from-amber-950/40 via-neutral-900 to-neutral-950 p-8 flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-400 flex items-center gap-2">
          <Icon name="material-symbols:handshake-outline-rounded" class="text-lg" />
          Ruang Kolaborasi
        </span>
        
        <h3 class="text-xl font-bold text-white">Diskusi Strategis</h3>
        <p class="text-xs text-neutral-300 leading-relaxed">
          Terbuka untuk kolaborasi dan peninjauan arsitektur dalam kapasitas:
        </p>

        <ul class="text-xs text-neutral-200 space-y-2.5 font-medium">
          <li class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">✓</span> Konsultasi Arsitektur Web
          </li>
          <li class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">✓</span> Audit & Efisiensi Sistem
          </li>
          <li class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">✓</span> Model Mental & Navigasi
          </li>
        </ul>
      </div>

      <a href="#contact" class="inline-flex justify-center items-center gap-2 text-sm font-bold text-neutral-950 bg-gradient-to-r from-amber-400 to-amber-300 hover:from-amber-300 hover:to-amber-200 py-3 px-6 rounded-xl transition-all shadow-lg shadow-amber-500/20 hover:scale-[1.02]">
        Inisiasi Diskusi
        <Icon name="material-symbols:arrow-forward-rounded" class="text-base" />
      </a>
    </div>
  </section>

</div>