---
// Milestone 2A: replace dummy content/assets below with approved real content.
// Hero and Possibilities are locked; Navbar/Footer belong to Milestone 2B.
import { getFeaturedPosts } from "@utils/featured";
import { getPostUrl } from "@utils/url";
const selectedThoughts = await getFeaturedPosts(3);
const dateFormatter = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

// DUMMY SNAPSHOT: these are examples, not confirmed personal learning claims.
const learningSnapshot = [
  { topic: "Eksplorasi optimasi fungsi AI dalam peningkatan produktifitas Personal maupun Profesional", status: "EXPLORING" },
  { topic: "Memahami alur informasi dalam rantai pasok industri", status: "LEARNING" },
  { topic: "Menghubungkan keyakinan dengan pengambilan keputusan sehari-hari", status: "REFLECTING" },
  { topic: "Memahami bagaimana kebiasaan terbentuk di dalam komunitas", status: "EXPLORING" },
];

// Featured Works: personal contributions, with image placeholders pending real assets.
const featuredWork = [
  {
    title: "Jalamas Artha Sakti",
    href: "/work/jalamas/",
    area: "BUSINESS · INDUSTRIAL OPERATIONS",
    description:
      "Membangun dan menjalankan usaha penyedia kebutuhan industri pertambangan, sambil menghadapi perubahan kebutuhan pelanggan dan dinamika rantai pasok.",
    learning:
      "Tekanan pasar mendorong saya untuk kembali menguji asumsi bisnis, mengevaluasi cara kerja yang selama ini dijalankan, dan mencari ruang untuk menghadirkan nilai yang lebih relevan.",
    image: "/assets/images/featured-work/jalamas.webp",
    imageAlt: "Ilustrasi pengganti untuk Jalamas",
  },
  {
    title: "Baduy Heritage",
    href: "https://baduyheritage.com",
    area: "CULTURE · DIGITAL ENTREPRENEURSHIP",
    description:
      "Mengembangkan platform digital yang memperkenalkan warisan budaya Baduy melalui cerita, informasi kunjungan, dan peluang bagi produk lokal.",
    learning:
      "Mewujudkan gagasan menjadi layanan nyata menuntut pembelajaran tentang kemitraan, penentuan harga, serta tanggung jawab dalam memperkenalkan budaya yang masih hidup dan dijalankan masyarakatnya.",
    image: "/assets/images/featured-work/baduy-heritage.webp",
    imageAlt: "Ilustrasi pengganti untuk Baduy Heritage",
  },
  {
    title: "Digital Projects",
    area: "TECHNOLOGY · WEB · EXPERIMENTATION",
    description:
      "Membangun dan bereksperimen dengan website serta alur kerja digital, termasuk website pribadi ini yang saya kembangkan sendiri.",
    learning:
      "Setiap iterasi mengajarkan pentingnya kemudahan penggunaan, keberlanjutan pengelolaan, dan pemanfaatan AI sebagai alat bantu tanpa menyerahkan penilaian kritis kepadanya.",
    image: "/assets/images/featured-work/digital-projects.webp",
    imageAlt: "Ilustrasi pengganti untuk Digital Projects",
  },
  {
    title: "Community Initiatives",
    area: "COMMUNITY · ORGANIZATION",
    description:
      "Keterlibatan dalam administrasi lingkungan dan kegiatan kemasyarakatan, mendalami dan mempelajari koordinasi antar elemen masyarakat hingga penataan informasi dan pelaksanaan program yang berdampak luas dan positif.",
    learning:
      "Koordinasi yang baik tidak cukup hanya mengandalkan prosedur. Ada kebutuhan untuk mendengarkan, menghormati perbedaan pandangan, dan membangun kepercayaan melalui pendekatan positif yang konsisten.",
    image: "/assets/images/featured-work/community-initiatives.webp",
    imageAlt: "Ilustrasi pengganti untuk Community Initiatives",
  },
];

// Homepage selection only. Replace dummy photos and supply relationship context.
// Detail links are intentionally omitted until the corresponding pages exist.
const networkSelection = [
  { name: "Prominent PR", expertise: "Agensi hubungan masyarakat dan komunikasi strategis", image: "/assets/images/homepage-dummy/portrait.svg", context: "Konteks persinggungan akan ditambahkan." },
  { name: "B&W Production", expertise: "Photography · Videography", image: "/assets/images/homepage-dummy/portrait.svg", context: "Konteks persinggungan akan ditambahkan." },
  { name: "The Excellence", expertise: "Management Consulting · Social Media · Digital Consulting", image: "/assets/images/homepage-dummy/portrait.svg", context: "Konteks persinggungan akan ditambahkan." },
];
---

<section
  aria-label="Rudy Saputra trial homepage"
  class="min-h-screen w-full overflow-x-hidden font-sans transition-colors duration-300
         bg-[var(--card-bg)] text-[#1c1b18]
         dark:bg-[#141413] dark:text-[#eceaee]"
>

  <!-- ======================================================
       HERO
       ====================================================== -->
  <header class="min-h-[85vh] flex flex-col justify-between pt-6 w-full transition-colors duration-300 bg-[var(--card-bg)] bg-olive-400/[0.21] dark:bg-white/[0.02]">
    <div class="w-[calc(100%-48px)] max-w-[1240px] mx-auto max-md:w-[calc(100%-32px)]">

      <!-- Meta / Brand Info -->
      <div class="flex justify-between items-center text-[0.85rem] font-semibold tracking-[0.1em] text-[#737067] dark:text-[#a09d98]">
        <div class="flex items-center gap-2">
          <span>RUDY SAPUTRA</span>
          <span class="opacity-90">·</span>
          <span>PERSONAL WEBSITE / 2026</span>
        </div>
      </div>

      <!-- Hero Content -->
      <div class="py-20 pb-15 max-md:py-16">
        <p class="m-0 text-[1.25rem] font-semibold leading-tight tracking-[0.14em] uppercase text-[#737067] dark:text-[#a09d98]">
          THINKING  ·  LEARNING  ·  MAKING THINGS
        </p>

        <h1 class="max-w-[1080px] my-5.5 mb-15 font-sans text-[clamp(3.2rem,8vw,7.8rem)] max-md:text-[clamp(2.8rem,12vw,5rem)] font-semibold leading-[0.96] tracking-[-0.04em] opacity-90">
          A place for ideas,<br />
          works &amp; things<br />
          worth remembering.
        </h1>

        <div class="grid grid-cols-[1fr_auto] max-md:grid-cols-1 gap-10 max-md:gap-7.5 items-end">
          <p class="max-w-[700px] m-0 text-[1.05rem] leading-[1.65] font-normal opacity-85">
            Selamat datang di lobi digital Rudy Saputra.<br>
            Di sini saya mencatat pemikiran, menulis pengalaman dan beberapa hal yang saya pelajari dan lakukan didalam perjalanan saya.
            Sebuah ruang yang bisa disinggahi siapapun.. 
          <br> Maka silahkan duduk, enjoy, dan buat kopimu sendiri. -RDS-
          </p>

          <span class="text-[0.80rem] font-semibold tracking-[0.12em] text-[#737067] dark:text-[#a09d98] max-md:hidden">
            SCROLL ↓
          </span>
        </div>
      </div>

    </div>
  </header>


  <!-- ======================================================
       TIGA ARAH
       ====================================================== -->
  <section class="w-full transition-colors duration-300 bg-[var(--card-bg)] bg-olive-400/[0.15] dark:bg-white/[0.04]">
    <div class="w-[calc(100%-48px)] max-w-[1240px] mx-auto max-md:w-[calc(100%-32px)] py-[clamp(80px,11vw,150px)]">

      <!-- Label -->
      <div class="flex justify-between gap-6 border-t border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)] pt-4 text-[0.68rem] font-semibold tracking-[0.12em] uppercase text-[#737067] dark:text-[#a09d98]">
        <span>RDS</span>
        <span>THE FRAMEWORK</span>
      </div>

      <!-- Heading -->
      <div class="grid grid-cols-[minmax(180px,0.7fr)_1.3fr] max-md:grid-cols-1 gap-10 max-md:gap-7.5 mt-18.75 max-md:mt-12.5">
        <p class="m-0 text-[1.25rem] font-semibold leading-tight tracking-[0.14em] uppercase text-[#737067] dark:text-[#a09d98]">
          A SIMPLE WAY OF MOVING THROUGH THINGS
        </p>
        <h2 class="m-0 font-sans text-[clamp(2.8rem,6.5vw,6.2rem)] font-semibold leading-[0.98] tracking-[-0.04em]">
          Thinking.<br />
          Learning.<br />
          Making Things.
        </h2>
      </div>

      <!-- Directions List -->
      <div class="mt-22.5 max-md:mt-15 border-t border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)]">
        <article class="grid grid-cols-[100px_1fr] max-md:grid-cols-[40px_1fr] gap-10 max-md:gap-4 py-9.5 border-b border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)]">
          <span class="text-[0.75rem] font-semibold text-[#737067] dark:text-[#a09d98]">01</span>
          <div>
            <h3 class="m-0 mb-3 font-sans text-[clamp(1.4rem,2.8vw,2.2rem)] font-semibold tracking-[-0.02em]">Berpikir</h3>
            <p class="max-w-[580px] m-0 opacity-80 leading-[1.7] text-[0.98rem]">
              Segala sesuatu dapat bermula dari pertanyaan. Mempertanyakan, menghubungkan, membandingkan, dan mencoba memahami sesuatu lebih dalam.
            </p>
          </div>
        </article>

        <article class="grid grid-cols-[100px_1fr] max-md:grid-cols-[40px_1fr] gap-10 max-md:gap-4 py-9.5 border-b border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)]">
          <span class="text-[0.75rem] font-semibold text-[#737067] dark:text-[#a09d98]">02</span>
          <div>
            <h3 class="m-0 mb-3 font-sans text-[clamp(1.4rem,2.8vw,2.2rem)] font-semibold tracking-[-0.02em]">Belajar</h3>
            <p class="max-w-[580px] m-0 opacity-80 leading-[1.7] text-[0.98rem]">
              Berpikir membawa kita pada batas pengetahuan. Di sanalah belajar dimulai, memperluas, menguji, dan mengoreksi cara kita memahami sesuatu.
            </p>
          </div>
        </article>

        <article class="grid grid-cols-[100px_1fr] max-md:grid-cols-[40px_1fr] gap-10 max-md:gap-4 py-9.5 border-b border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)]">
          <span class="text-[0.75rem] font-semibold text-[#737067] dark:text-[#a09d98]">03</span>
          <div>
            <h3 class="m-0 mb-3 font-sans text-[clamp(1.4rem,2.8vw,2.2rem)] font-semibold tracking-[-0.02em]">Membuat Sesuatu</h3>
            <p class="max-w-[580px] m-0 opacity-80 leading-[1.7] text-[0.98rem]">
              Pemikiran dan pembelajaran menemukan bentuknya ketika sesuatu dilakukan, ketika gagasan mulai memiliki konsekuensi di dunia nyata.
            </p>
          </div>
        </article>
      </div>

    </div>
  </section>


  <!-- ======================================================
       THINKING - JOURNAL OF THOUGHT
       ====================================================== -->
  <section class="w-full transition-colors duration-300 bg-olive-400/[0.15] dark:bg-white/[0.07]">
    <div class="w-[calc(100%-48px)] max-w-[1240px] mx-auto max-md:w-[calc(100%-32px)] py-[clamp(80px,11vw,150px)]">

      <div class="flex justify-between gap-6 border-t border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)] pt-4 text-[0.68rem] font-semibold tracking-[0.12em] uppercase text-[#737067] dark:text-[#a09d98]">
        <span>RDS</span>
        <span>THOUGHTS</span>
      </div>

      <div class="grid grid-cols-[1.35fr_0.65fr] max-md:grid-cols-1 gap-[70px] max-md:gap-7.5 mt-20">
        <p class="max-w-[850px] m-0 font-sans text-[clamp(2.6rem,5.5vw,5.8rem)] max-md:text-[clamp(2.2rem,10vw,4rem)] font-medium leading-[1.05] tracking-[-0.04em]">
          A place for thoughts
          <em class="text-green-700 dark:text-emerald-200 not-italic font-normal">worth writing down.</em>
        </p>

        <div class="self-end">
          <p class="m-0 mb-8.75 opacity-80 leading-[1.7] text-[0.98rem]">
            Ada hal-hal yang tidak cukup dituliskan dalam satu kolom postingan media sosial. Di sini tertulis catatan atas pemikiran, pertanyaan, pengamatan, dan pengalaman, sebagai upaya untuk memahami sesuatu lebih jauh.
          </p>

          <a href="/journal/" class="font-medium text-current no-underline border-b-[1.5px] border-current pb-1 transition-colors duration-180 ease-in-out hover:text-[#b85b32] hover:border-[#b85b32] dark:hover:text-[#e08358] dark:hover:border-[#e08358]">
            Jelajahi Catatan.. <span>↗</span>
          </a>
        </div>
      </div>

    </div>
  </section>

<!-- ======================================================
       NOTES
       ====================================================== -->
  <section class="w-full transition-colors duration-300 bg-olive-400/[0.18] dark:bg-white/[0.03]">
    <div class="w-[calc(100%-48px)] max-w-[1240px] mx-auto max-md:w-[calc(100%-32px)] py-[clamp(80px,11vw,150px)]">

      <div class="flex justify-between gap-6 border-t border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)] pt-4 text-[0.68rem] font-semibold tracking-[0.12em] uppercase text-[#737067] dark:text-[#a09d98]">
        <span>RDS</span>
        <span>SELECTED THOUGHTS FROM JOURNAL</span>
      </div>

      <!-- Editorial placeholders. Replace the shared illustration and excerpts with real articles. -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-12 mt-20 max-md:mt-15">
        {selectedThoughts.map((thought) => (
          <a
         href={getPostUrl(thought)}
         class="group min-w-0 flex flex-col text-inherit no-underline"
         >
            <div class="aspect-[16/10] overflow-hidden bg-[#e6e0d4] dark:bg-[#282622]">
              <div class="w-full h-full flex items-center justify-center text-sm opacity-50">Journal</div>
            </div>
            <p class="mt-6 mb-3 text-[0.7rem] tracking-[0.05em] text-[#737067] dark:text-[#a09d98]">{thought.data.category || "Journal"}</p>
            <h3 class="m-0 font-sans text-[clamp(1.35rem,2.3vw,2rem)] font-medium leading-[1.2] tracking-[-0.02em]">{thought.data.title}</h3>
            <p class="mt-4 mb-6 text-[0.95rem] leading-[1.65] opacity-80 line-clamp-3">{thought.data.description}</p>
            <div class="mt-auto flex justify-between items-center gap-4 border-t border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)] pt-4">
              <time datetime={new Date(thought.data.published).toISOString()} class="text-[0.7rem] tracking-[0.05em] text-[#737067] dark:text-[#a09d98]">{dateFormatter.format(new Date(thought.data.published))}</time>
              <span aria-hidden="true" class="motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:translate-x-1">→</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>


  <!-- ======================================================
       READING / LEARNING
       ====================================================== -->
  <section class="w-full transition-colors duration-300 bg-[#f6f4ee] dark:bg-[#171715]">
    <div class="w-[calc(100%-48px)] max-w-[1240px] mx-auto max-md:w-[calc(100%-32px)] py-[clamp(80px,11vw,150px)]">

      <div class="flex justify-between gap-6 border-t border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)] pt-4 text-[0.68rem] font-semibold tracking-[0.12em] uppercase text-[#737067] dark:text-[#a09d98]">
        <span>04</span>
        <span>READING / LEARNING</span>
      </div>

      <div class="grid grid-cols-[1.2fr_0.8fr] max-md:grid-cols-1 gap-20 max-md:gap-7.5 mt-20 items-end">
        <h2 class="m-0 font-sans text-[clamp(2.8rem,6vw,5.8rem)] font-semibold leading-[1.02] tracking-[-0.04em]">
          Things I am<br /><em class="text-[#9c451e] dark:text-[#f0956b] not-italic font-normal">trying to understand.</em>
        </h2>
        <p class="max-w-[390px] m-0 opacity-80 leading-[1.7] text-[0.98rem]">
          Buku, tulisan, gagasan, perangkat, dan berbagai persoalan yang belakangan ini menarik perhatian saya untuk dipelajari lebih jauh.
        </p>
      </div>

      <div class="mt-20 max-md:mt-15">
        <p class="mb-5 text-[0.7rem] tracking-[0.08em] uppercase text-[#737067] dark:text-[#a09d98]">SNAPSHOT</p>
        <ul class="m-0 p-0 list-none border-t border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)]">
          {learningSnapshot.map((item, index) => (
            <li class="grid grid-cols-[55px_1fr_auto] max-md:grid-cols-[35px_1fr] gap-x-5 gap-y-2 items-start py-6 border-b border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)]">
              <span aria-hidden="true" class="text-[0.72rem] font-semibold text-[#737067] dark:text-[#a09d98]">{String(index + 1).padStart(2, "0")}</span>
              <span class="text-[1.1rem] font-medium leading-[1.5]">{item.topic}</span>
              <span class="max-md:col-start-2 text-[0.65rem] font-semibold tracking-[0.08em] text-[#737067] dark:text-[#a09d98]">{item.status}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </section>


  <!-- ======================================================
       WORK & MAKING
       ====================================================== -->
  <section class="w-full transition-colors duration-300 bg-olive-400/[0.21] dark:bg-white/[0.07]">
    <div class="w-[calc(100%-48px)] max-w-[1240px] mx-auto max-md:w-[calc(100%-32px)] py-[clamp(80px,11vw,150px)]">

      <div class="flex justify-between gap-6 border-t border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)] pt-4 text-[0.68rem] font-semibold tracking-[0.12em] uppercase text-[#737067] dark:text-[#a09d98]">
        <span>RDS</span>
        <span>FEATURED WORK</span>
      </div>

      <div class="mt-20">
        <h2 class="m-0 max-w-[900px] font-sans text-[clamp(2.8rem,6vw,5.8rem)] font-semibold leading-[1.02] tracking-[-0.04em]">
       Things I've built<br />
       &amp; worked on.
        </h2>
      </div>

      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-16 mt-20 max-md:mt-12">
        {featuredWork.map((work, index) => (
          <article class="group min-w-0 flex flex-col">
            <div class="aspect-[16/10] overflow-hidden bg-[#e6e0d4] dark:bg-[#282622]">
             <img
               src={work.image}
                alt={work.imageAlt}
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.025]"
              />
            </div>

              <div class="pt-6 flex flex-col flex-1">
                <div class="flex items-start justify-between gap-4">
                  <p class="m-0 text-[0.68rem] font-semibold leading-[1.5] tracking-[0.1em] uppercase text-[#737067] dark:text-[#a09d98]">
                    {work.area}
                  </p>
                  <span class="text-[0.72rem] text-[#737067] dark:text-[#a09d98]">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </div>

                <h3 class="mt-4 mb-4 font-sans text-[clamp(1.8rem,3vw,2.7rem)] font-semibold leading-[1.15] tracking-[-0.03em]">
                    {work.href ? (
                    <a href={work.href} class="hover:underline underline-offset-4">
                    {work.title} <span aria-hidden="true">↗</span>
                    </a>
                    ) : (
                    work.title
                  )}
                </h3>

                <p class="m-0 max-w-[520px] opacity-80 leading-[1.7] text-[0.98rem]">
                  {work.description}
                </p>

              <div class="mt-auto pt-8">
                <p class="m-0 mb-3 pt-4 border-t border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)] text-[0.72rem] font-semibold tracking-[0.09em] uppercase text-[#737067] dark:text-[#a09d98]">
                  THE WORK &amp; LEARNING
                </p>
                <p class="m-0 text-[0.95rem] leading-[1.7] opacity-85">
                  {work.learning}
                </p>
              </div>
            </div>
          </article>
        ))}
      </div>

    <div class="mt-16 max-md:mt-12">

   <div class="flex justify-between gap-6 border-t border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)] pt-4 text-[0.68rem] font-semibold tracking-[0.12em] uppercase text-[#737067] dark:text-[#a09d98]">
    <span>RDS</span>
    <span>AREAS OF PRACTICE</span>
   </div>

   <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 mt-6">
    {[
      "Bisnis & Operasional Industri",
      "Produk Digital & Teknologi",
      "Warisan Budaya & Kewirausahaan",
      "Komunitas & Organisasi",
      "Sistem & Pemecahan Masalah",
      "Tulisan & Gagasan",
    ].map((area, index) => (
      <div class="grid grid-cols-[35px_1fr] gap-3 py-4 border-b border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)] items-center">
        <span class="text-[0.72rem] font-semibold text-[#737067] dark:text-[#a09d98]">
          {String(index + 1).padStart(2, "0")}
        </span>

        <span class="font-sans text-[0.98rem] font-medium tracking-[-0.02em]">
          {area}
        </span>
      </div>
    ))}
   </div>

   </div>
     </div>
  </section>

<!-- ======================================================
     ACROSS THE JOURNEY
     ====================================================== -->
<section class="w-full transition-colors duration-300 bg-[#f6f4ee] dark:bg-[#171715]">
  <div class="w-[calc(100%-48px)] max-w-[1240px] mx-auto max-md:w-[calc(100%-32px)] py-[clamp(80px,11vw,150px)]">

    <!-- Section Label -->
    <div class="flex justify-between gap-6 border-t border-[rgba(28,27,24,0.12)] dark:border-[rgba(236,234,238,0.14)] pt-4 text-[0.68rem] font-semibold tracking-[0.12em] uppercase text-[#737067] dark:text-[#a09d98]">
      <span>RDS</span>
      <span>ACROSS THE JOURNEY</span>
    </div>

    <!-- Intro -->
    <div class="grid grid-cols-[1.2fr_0.8fr] max-md:grid-cols-1 gap-20 max-md:gap-8 mt-20 items-end">

      <h2 class="m-0 font-sans text-[clamp(2.8rem,6vw,5.8rem)] font-semibold leading-[1.02] tracking-[-0.04em]">
        Different people.<br />
        Different expertise.<br />
        <em class="font-normal not-italic text-green-700 dark:text-emerald-200">
          More possibilities.
        </em>
      </h2>

